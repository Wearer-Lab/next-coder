# Next Coder gateway environment.
#
# This file is the complete catalogue of every environment variable the repository reads. It is
# tracked; the files that hold real values are not, and must never be committed:
#
#   .env       local development. Loaded first by `npm start`, `npm run dev:server` and
#              `npm run setup:tunnel` (node --env-file-if-exists=.env).
#   .env.local local overrides. Loaded second by the same commands, so it wins over .env for the
#              names it defines. Holds this workstation's deployment branch and dev Clerk instance.
#   .env.prod  production values. NOT loaded automatically: no script in this repository reads it.
#              A production run must select it explicitly, e.g.
#              `node --env-file=.env.prod --env-file-if-exists=.env.local src/server.mjs`.
#
# Precedence, lowest to highest: .env, then .env.local, then whatever file is passed last.
# Only .env and .env.local are loaded by the npm scripts.
#
# Values below are placeholders. Anything marked "replace" must be replaced before the gateway is
# trusted with real traffic, and no real value ever belongs in this file.

# ---------------------------------------------------------------------------------------------
# Gateway process
# ---------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3996
PUBLIC_BASE_URL=http://127.0.0.1:3996
# `cloud` hides self-hosted tunnel controls and presents connector-first operations in the console.
DEPLOYMENT_MODE=self-hosted
# `npm run setup:tunnel -- --mode serve --write-env` replaces PUBLIC_BASE_URL with
# the Tailscale HTTPS origin and appends it to CLERK_AUTHORIZED_PARTIES.
DATA_FILE=.data/next-coder.json
MEDIA_DIR=.data/media
# `local` | `staging` | `production`. Read by the container server and by the Cloudflare runtime.
DEPLOYMENT_ENVIRONMENT=local
# The control plane's private container listens on this port inside the Worker; it must differ
# from PORT.
# INTERNAL_HOST=0.0.0.0
# INTERNAL_PORT=3998
# Private origin of the control plane's connector router, used by the container to reach it.
# CONNECTOR_ROUTER_BASE_URL=http://connector-router.internal
# The name a controller sees during LAN discovery. Defaults to the machine's hostname.
# DISCOVERY_NAME=my-gateway
# Set to 0 to stop answering LAN discovery broadcasts. On by default.
# DISCOVERY_ENABLED=1
DEFAULT_HARDWARE_MODEL=e213-esp32-s3r8
# 1 turns on the hosted demo mode.
DEMO_MODE=0
# Allows the gateway to mint development tokens. On by default for the `dev` auth provider.
# ENABLE_DEV_TOKENS=0
# `clerk` | `dev`. Defaults to `clerk` when CLERK_SECRET_KEY is set, `dev` otherwise.
AUTH_PROVIDER=clerk
# Phase 4 "TLS only": refuse to issue or accept device credentials over plaintext.
# Loopback stays exempt for local development. See docs/production-security.md.
REQUIRE_TLS=0
# Issuing roots embedded into generated factory controller_config.h files. Keep the current and next
# roots during CA rotation; production firmware refuses HTTPS when the current root is empty.
# GATEWAY_TLS_ROOT_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# GATEWAY_TLS_NEXT_ROOT_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------
# `file` (or `memory`) | `convex`.
STORAGE_PROVIDER=convex
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
# Shared secret the gateway presents to the Convex functions. Never returned by the API.
GATEWAY_CONVEX_SECRET=replace-with-shared-gateway-convex-secret
# Encrypts T3 access tokens at rest. Falls back to GATEWAY_TOKEN_ENCRYPTION_KEY.
T3_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-or-longer-token-encryption-secret
# Alternative spelling of T3_TOKEN_ENCRYPTION_KEY; the T3_ name wins.
# GATEWAY_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-or-longer-token-encryption-secret
# Signs the short-lived media URLs handed to T3 as attachments.
# Falls back to T3_TOKEN_ENCRYPTION_KEY, then GATEWAY_CONVEX_SECRET.
MEDIA_SIGNING_KEY=replace-with-media-url-signing-secret

# ---------------------------------------------------------------------------------------------
# Authentication (Clerk)
# ---------------------------------------------------------------------------------------------
# The gateway's own key. Server-side only: never send it to a browser.
CLERK_SECRET_KEY=sk_test_replace
# The publishable key the browser console hands to Clerk. CLERK_PUBLISHABLE_KEY wins when both are
# set; the VITE_ spelling is the one this repository's local files use.
CLERK_PUBLISHABLE_KEY=pk_test_replace
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3996,https://gateway.example.com
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.clerk.accounts.dev
# Audience the connector tickets are minted for. Must match the edge's binding.
CONNECTOR_TICKET_AUDIENCE=agent-controller-connectors
# Factory secret for provisioning controllers. Generate one per factory, never per device.
# FACTORY_TOKEN=replace-with-factory-secret

# ---------------------------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------------------------
MAX_MEDIA_BYTES=2097152
# The ceiling for an owner upload, which is larger than the device-facing limit.
# MAX_OWNER_MEDIA_BYTES=67108864
# Largest image the gateway will decode, in pixels and per side.
# MAX_IMAGE_DIMENSION=8192
# MAX_IMAGE_PIXELS=40000000
# Longest audio clip the transcription pipeline accepts, and the limits on its format.
# MAX_AUDIO_DURATION_SECONDS=300
# MAX_AUDIO_SAMPLE_RATE=96000
# MAX_AUDIO_CHANNELS=2
MEDIA_UPLOAD_SESSION_TTL_MS=900000
DEFAULT_MEDIA_RETENTION_DAYS=30
ENVIRONMENT_RETENTION_DAYS=30
MEDIA_LINK_TTL_SECONDS=900
# Media at or under this size is also inlined into the dispatch payload so an
# environment that cannot call back to the gateway still receives the bytes.
MEDIA_INLINE_MAX_BYTES=262144

# ---------------------------------------------------------------------------------------------
# Media object storage
# ---------------------------------------------------------------------------------------------
# Media object storage. "disk" keeps files under MEDIA_DIR; "s3" uses any S3-compatible bucket.
MEDIA_STORAGE_PROVIDER=disk
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=agent-controller-media
# S3_ACCESS_KEY_ID=replace
# S3_SECRET_ACCESS_KEY=replace
# Session token for temporary S3 credentials.
# S3_SESSION_TOKEN=replace
# Leave S3_FORCE_PATH_STYLE unset to auto-detect: MinIO/R2 need path style, AWS does not.
# S3_FORCE_PATH_STYLE=1
# S3_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------------------------
# Firmware artifacts
# ---------------------------------------------------------------------------------------------
# Durable firmware artifacts. Use a private S3/R2 bucket in production; downloads remain behind
# device authentication and storage credentials are never returned by the API.
# FIRMWARE_STORAGE_PROVIDER=s3
# FIRMWARE_S3_BUCKET=agent-controller-firmware
# FIRMWARE_S3_PREFIX=firmware
# FIRMWARE_DIR=.data/firmware
# MAX_FIRMWARE_BYTES=16777216
# Optional dedicated HMAC key for short-lived legacy OTA download capabilities. If omitted,
# OTA_SIGNING_KEY is used. Keep this server-side; it is never returned to a controller.
# FIRMWARE_DOWNLOAD_SIGNING_KEY=replace-with-random-server-secret
# FIRMWARE_DOWNLOAD_TTL_SECONDS=600
# Signs the firmware manifests the gateway publishes. Server-side only.
# OTA_SIGNING_KEY=replace-with-firmware-manifest-signing-key

# ---------------------------------------------------------------------------------------------
# Transcription and vision
# ---------------------------------------------------------------------------------------------
# TRANSCRIPTION_PROVIDER: disabled | mock | openai | parakeet
#
# Leaving this unset is the same as "disabled", and a disabled provider fails every job
# terminally with "No transcription provider is configured." — the voice pipeline is dead
# end to end until this names a real one. "mock" returns a fabricated transcript and must
# never reach a deployment that dispatches to an agent.
#
# "parakeet" is the intended local path: nvidia/parakeet-tdt-0.6b-v2 running in the sidecar
# at scripts/parakeet-sidecar.py, which the gateway only ever talks HTTP to.
#
#   npm run parakeet:fetch      # ~630 MB of ONNX weights into PARAKEET_MODEL_DIR
#   npm run parakeet:sidecar    # loads them and listens on 127.0.0.1:8977
TRANSCRIPTION_PROVIDER=parakeet
# TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=sk-replace
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_TIMEOUT_MS=30000
# Language hint passed to the provider when it does not detect one itself.
# TRANSCRIPTION_LANGUAGE=en
# The transcription worker is a durable job, not a request: these govern the worker, not the API.
# TRANSCRIPTION_WORKER_ENABLED=1
# TRANSCRIPTION_WORKER_INTERVAL_MS=2000
# How many jobs one worker tick claims.
# TRANSCRIPTION_BATCH_SIZE=4
# The lease must outlast one provider call, or a slow job is picked up twice.
# TRANSCRIPTION_LEASE_MS=60000
# TRANSCRIPTION_MAX_ATTEMPTS=3
# Park a finished transcript at `review_required` until a person accepts or edits it.
# TRANSCRIPTION_REVIEW_REQUIRED=0
# Where the sidecar listens. Must match the --port/--route it was started with.
# PARAKEET_URL=http://127.0.0.1:8977/v1/transcribe
# Where `npm run parakeet:fetch` writes the weights and the sidecar reads them from.
# Under .data/ so it is already gitignored; never commit the weights.
# PARAKEET_MODEL_DIR=.data/models/parakeet-tdt-0.6b-v2-onnx
# The checkpoint repository the fetch script pulls from.
# PARAKEET_MODEL_REPO=nvidia/parakeet-tdt-0.6b-v2
# int8 (~630 MB, the default) or fp32 (~2.5 GB, slower on CPU for a marginal gain).
# PARAKEET_MODEL_PRECISION=int8
# The checkpoint the gateway believes is loaded; the sidecar refuses a mismatch.
# PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
# v2 is ENGLISH ONLY. Another language is a terminal configuration error, not a degraded
# transcript — the model would return confident English-shaped nonsense and the gateway
# would dispatch it. Use a multilingual checkpoint instead of changing this.
# PARAKEET_LANGUAGE=en
# CPU inference is minutes, not seconds, on a long clip.
# PARAKEET_TIMEOUT_MS=120000
# A WAV whose own header exceeds this is refused before any inference is spent.
# PARAKEET_MAX_CLIP_SECONDS=120
# One model in memory on a CPU is one clip at a time; raise it only on a GPU box.
# PARAKEET_CONCURRENCY=1
# PARAKEET_ACCEPTED_CONTENT_TYPES=audio/wav,audio/webm,audio/ogg,audio/mp4
# Only needed when the sidecar sits behind an authenticated hop.
# PARAKEET_API_KEY=replace
# VISION_PROVIDER: disabled | mock | openai. Powers POST /v1/media/:id/describe, whose
# description is attached to the prompt so the agent gets the image content even when it
# cannot fetch or see the image itself.
VISION_PROVIDER=disabled
# VISION_URL=https://api.openai.com/v1/chat/completions
# VISION_API_KEY=sk-replace
# VISION_MODEL=gpt-4o-mini
# VISION_TIMEOUT_MS=30000
# Ceiling on the description's length.
# VISION_MAX_TOKENS=600
# Replaces the built-in instruction that asks the model to describe the image.
# VISION_PROMPT=replace-with-custom-instruction

# ---------------------------------------------------------------------------------------------
# Web push
# ---------------------------------------------------------------------------------------------
# The VAPID key pair the browser subscribes with. WEB_PUSH_VAPID_KEYS is the JSON form used by
# the deployed control plane; the single-key spelling is the local one.
# WEB_PUSH_VAPID_KEYS=[{"keyId":"primary","publicKey":"replace","privateKey":"replace","subject":"mailto:ops@example.com"}]
# WEB_PUSH_VAPID_KEY_ID=primary
# WEB_PUSH_VAPID_PUBLIC_KEY=replace
# WEB_PUSH_VAPID_PRIVATE_KEY=replace
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
# Origins allowed to receive a push. Empty means none.
# WEB_PUSH_ALLOWED_HOSTS=https://gateway.example.com
# Encrypts stored push subscriptions. Falls back to T3_TOKEN_ENCRYPTION_KEY.
# WEB_PUSH_STORAGE_ENCRYPTION_KEY=replace-with-random-server-secret
# The push worker is a durable job; these govern the worker, not the API.
# WEB_PUSH_WORKER_ENABLED=1
# WEB_PUSH_WORKER_INTERVAL_MS=2000

# ---------------------------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------------------------
# Background T3 snapshot polling for users with a live stream or a recent device heartbeat.
SNAPSHOT_POLL_ENABLED=1
SNAPSHOT_POLL_INTERVAL_MS=5000
# The live thread stream. The tick is a scheduler: it opens and closes subscriptions, never
# fetches, so a short interval is cheap.
# THREAD_STREAM_ENABLED=1
# THREAD_STREAM_INTERVAL_MS=1000
# How long a watch lease is held before the console has to renew it.
# THREAD_STREAM_WATCH_TTL_MS=90000
# The cloud consumers are the Queue-backed halves of the background work. Each one is off unless
# the deployment that owns its queue turns it on.
# CLOUD_SNAPSHOT_CONSUMER_ENABLED=0
# CLOUD_THREAD_STREAM_CONSUMER_ENABLED=0
# CLOUD_MEDIA_CONSUMER_ENABLED=0
# CLOUD_CONNECTOR_EVENT_CONSUMER_ENABLED=0
# CLOUD_RETENTION_CONSUMER_ENABLED=0

# ---------------------------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------------------------
# Policy: comma-separated trusted origins (CIDR, exact IP, or the literal "loopback").
# Leave unset to disable network-location policy entirely. When set, requests from outside
# these ranges escalate shell input to an approval gate.
# TRUSTED_NETWORKS=loopback,10.0.0.0/8
# Policy: global allowed-hours window, "START-END" in local time, or a JSON window object.
# POLICY_ALLOWED_HOURS=9-18

# ---------------------------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT=30
FACTORY_WRITE_RATE_LIMIT=30
USER_READ_RATE_LIMIT=240
USER_WRITE_RATE_LIMIT=60
DEVICE_HEARTBEAT_RATE_LIMIT=120
DEVICE_READ_RATE_LIMIT=120
DEVICE_WRITE_RATE_LIMIT=30
# Limits on the connector's own write and redeem routes.
# CONNECTOR_WRITE_RATE_LIMIT=60
# CONNECT_REDEEM_RATE_LIMIT=20
# Share one rate-limit window across processes. Unset means per-process limits, so N instances
# allow N times the configured limit.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------------------------
# Alert thresholds
# ---------------------------------------------------------------------------------------------
# Alert thresholds default to the roadmap's beta success criteria.
# ALERT_ACK_MEDIAN_MS=2000
# ALERT_ACK_P95_MS=8000
# ALERT_DISPATCH_MEDIAN_MS=10000
# ALERT_COMMAND_FAILURE_RATIO=0.1
# Commands needed before a failure ratio is worth alerting on.
# ALERT_MIN_COMMANDS=10
# ALERT_LOW_BATTERY_PERCENT=20

# ---------------------------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------------------------
# Billing. Plan limits and tier-based policy stay inert until BILLING_ENFORCED=1, because the
# default free tier grants 0 devices and no shell access.
BILLING_ENFORCED=0
# BILLING_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# ---------------------------------------------------------------------------------------------
# Cloudflare deployment (edge Worker and private control plane)
# ---------------------------------------------------------------------------------------------
# These are the environment variables of the deployed Workers. The edge and the control plane
# read them as Worker bindings, so they are set with `wrangler secret put` / the wrangler
# configuration rather than from a .env file — except where a local deployment reads a .env.
#
# The control plane copies these into the container it starts, so the names and their meanings
# are the ones documented in the sections above; only the ones that exist solely for the
# Cloudflare runtime are listed here.
#
# DEPLOYMENT_ENVIRONMENT is the same name as the local one above; the deployed Workers set it to
# staging or production.
# CONNECTOR_AUTH_MODE=control-plane
# How long the control plane waits for its container to start serving.
# CONTAINER_STARTUP_TIMEOUT_MS=20000
# How long it waits for that container's first response headers.
# CONTAINER_RESPONSE_HEADER_TIMEOUT_MS=30000
# Sampling rate for the success telemetry dataset.
# TELEMETRY_SUCCESS_SAMPLE_RATE=0.1
#
# The following are Worker bindings rather than environment variables — a queue, a bucket, a
# durable object namespace or a service binding. They are configured in the wrangler
# configuration, never here: ASSETS, BACKGROUND_TASKS, BACKGROUND_QUARANTINE, CONNECTOR_EVENTS,
# CONNECTOR_EVENT_SINK, CONTROL_PLANE, CONNECTOR_ROUTER, AGENT_CONTROLLER_GATEWAY,
# ENVIRONMENT_CONNECTOR_HUB, DEV_CONNECTOR_TICKETS, MEDIA_BUCKET, TELEMETRY,
# ROUTER_SHARED_SECRET, DEV_TICKET_ISSUER_SECRET, CONVEX_HTTP_BASE_URL.

# ---------------------------------------------------------------------------------------------
# Deployment tooling
# ---------------------------------------------------------------------------------------------
# Credentials for the deployment scripts (scripts/bootstrap-staging.mjs, scripts/staging-release.mjs,
# scripts/promote-production.mjs). They are machine credentials: they belong in .env or in the
# CI environment, never in this file.
#
# Account-scoped token with Workers/Containers and Queues write plus R2 read.
# CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
# The exact 32 lowercase hex account id the token is scoped to. The scripts refuse to run
# without it.
# CLOUDFLARE_ACCOUNT_ID=replace-with-32-hex-account-id
# Convex deploy key, used by the same scripts to deploy the Convex functions.
# CONVEX_DEPLOY_KEY=replace-with-convex-deploy-key
#
# The scripts also read a set of CI-only control variables (STAGING_* and PRODUCTION_*) that the
# GitHub Actions workflows supply; they are not workstation configuration.

# ---------------------------------------------------------------------------------------------
# Tooling overrides (scripts/ and packages/connector)
# ---------------------------------------------------------------------------------------------
# Per-invocation overrides for the repository scripts. Each one has a command-line flag that
# takes precedence, so these are only for pinning a default in the environment.
#
# Firmware matrix and release scripts.
# FIRMWARE_CHANNEL=stable
# FIRMWARE_VERSION=1.0.0
# FIRMWARE_FILE=.data/firmware/firmware.bin
# FIRMWARE_MANDATORY=0
# FIRMWARE_RELEASE_NOTES=replace-with-release-notes
# FIRMWARE_BUILD_TIMEOUT_MS=1800000
# FIRMWARE_PIO_BIN=pio
# TLS terminator bench.
# BENCH_TLS_CERT=replace-with-certificate-path
# BENCH_TLS_KEY=replace-with-key-path
# BENCH_TLS_PORT=8443
# BENCH_TLS_TARGET=127.0.0.1:3996
# Mock T3 server used by the local smoke flows.
# MOCK_T3_HOST=127.0.0.1
# MOCK_T3_PORT=4010
# MOCK_T3_URL=http://127.0.0.1:4010
# Gateway the local flows point at.
# PUBLIC_GATEWAY_URL=http://127.0.0.1:3996
# Manufacturing batch defaults.
# HARDWARE_MODEL=e213-esp32-s3r8
# DEVICE_PROFILE=default
# LABEL_PREFIX=batch
# COUNT=1
# OUTPUT_DIR=.data/out
# QR code rendering for the claim label.
# QR_ANSI=0
# QR_STYLE=replace-with-qr-style
# Hugging Face credentials for the model fetch.
# HF_ENDPOINT=https://huggingface.co
# HF_TOKEN=replace-with-huggingface-token
# Connector npm release evidence bundle.
# NPM_CONNECTOR_RELEASE_EVIDENCE_PATH=.data/evidence
# NPM_CONNECTOR_RELEASE_OUTPUT_DIR=.data/release
# NPM_CONNECTOR_RELEASE_REPOSITORY_ROOT=.
# OTA manifest verification in the publishing scripts.
# OTA_MANIFEST_VERIFY_KEY=replace-with-public-key-path
# REQUIRE_OTA_SIGNATURE=0
# ENABLE_OTA_APPLY=0
#
# The connector CLI reads its own environment. NEXT_CODER_* is the current spelling and
# AGENT_CONTROLLER_* is the pre-rename fallback; both are read.
# NEXT_CODER_CONFIG_DIR=replace-with-config-directory
# NEXT_CODER_T3_TOKEN=replace-with-t3-token
# AGENT_CONTROLLER_CONFIG_DIR=replace-with-config-directory
# AGENT_CONTROLLER_T3_TOKEN=replace-with-t3-token
