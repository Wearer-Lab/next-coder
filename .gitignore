node_modules/
.data/
# The Parakeet sidecar's own interpreter (scripts/parakeet-sidecar.py). Created by
# `uv venv .venv-parakeet`; the ~630 MB of model weights live under .data/models/.
.venv-parakeet/
.manufacturing/
firmware/esp32-controller/.pio/
firmware/*/.pio/
# A board's checked-in example is the only controller_config variant allowed in source control.
# Ignore local, backup, editor, and future live-config suffixes by default.
firmware/*/include/controller_config*
!firmware/*/include/controller_config.example.h
.wrangler/
cloudflare/.wrangler/
cloudflare-control-plane/.wrangler/
.env
.DS_Store
coverage/
dist/
*.log

.env.local
.env.prod

# Vendor download kits for the CrowPanel and Hosyond boards: hundreds of megabytes of archives,
# datasheets, 3D models, flashing tools, and third-party example libraries. Reference material,
# not source, and not ours to redistribute. Each folder keeps a README.md that says where to
# download the kit. The pieces the firmware actually builds against are vendored under
# firmware/<board>/ and firmware/shared/ and committed.
firmware/CrowPanel-ESP32-2.13-E-paper/docs/*
!firmware/CrowPanel-ESP32-2.13-E-paper/docs/README.md
firmware/Hosyond-ESP32-S3-2.8-Touchscreen/docs/*
!firmware/Hosyond-ESP32-S3-2.8-Touchscreen/docs/README.md
# Machine-specific editor configuration generated by the PlatformIO IDE extension.
firmware/*/.vscode/c_cpp_properties.json
firmware/*/.vscode/launch.json
