{
  "name": "@next-coder/cloudflare-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types --env-interface CloudflareControlPlaneBindings && tsc --noEmit",
    "test": "vitest run",
    "test:capacity": "vitest run --config vitest.capacity.config.ts",
    "test:container-contract": "vitest run test/container-server.test.mjs",
    "container:build": "BUILDX_GIT_INFO=false BUILDX_GIT_LABELS=false BUILDX_GIT_CHECK_DIRTY=false docker build --platform linux/amd64 --progress=plain --tag next-coder-control-plane:local-smoke --file Dockerfile ..",
    "container:smoke": "node scripts/container-smoke.mjs",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "dry-run:staging": "wrangler deploy --dry-run --containers-rollout=none --env staging --outdir .wrangler/dry-run-staging",
    "dry-run:production": "wrangler deploy --dry-run --containers-rollout=none --env production --outdir .wrangler/dry-run-production"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.0"
  }
}
