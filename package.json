{
  "name": "next-coder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud control plane for remote agent controller devices and T3 Code environments.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spyhack225/next-coder.git"
  },
  "homepage": "https://github.com/spyhack225/next-coder#readme",
  "bugs": {
    "url": "https://github.com/spyhack225/next-coder/issues"
  },
  "scripts": {
    "prestart": "npm run build:app",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.mjs",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/server.mjs",
    "dev:app": "vite --config frontend/vite.config.ts",
    "dev:web": "npm run dev:app",
    "build": "npm run build:app",
    "build:app": "vite build --config frontend/vite.config.ts",
    "build:web": "npm run build:app",
    "check:frontend-performance": "node scripts/check-frontend-performance.mjs",
    "test:browser-performance": "npm run build:app && npm run check:frontend-performance && npx vitest run --config frontend/vitest.config.ts src/frameBatcher.test.ts src/liveThread.test.ts src/useThreadWatch.test.tsx",
    "typecheck:app": "tsc -p frontend/tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck:app",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "typecheck:cloud": "npm --prefix cloudflare run typecheck",
    "typecheck:cloud-control-plane": "npm --prefix cloudflare-control-plane run typecheck",
    "test:app": "vitest run --config frontend/vitest.config.ts",
    "test:web": "npm run test:app",
    "test:server": "node --test test/[a-z]*.test.mjs",
    "test:connector": "npm --prefix packages/connector test",
    "test:cloud": "npm --prefix cloudflare run test:contract && npm --prefix cloudflare run test:workers && npm --prefix cloudflare run test:resilience",
    "test:cloud-control-plane": "npm --prefix cloudflare-control-plane test",
    "test:container": "npm --prefix cloudflare-control-plane run container:smoke",
    "test:capacity": "node --test test/capacitySlo.test.mjs && npm --prefix cloudflare run test:capacity && npm --prefix cloudflare-control-plane run test:capacity && node scripts/capacity-local.mjs --assert",
    "test:resilience": "node --test packages/connector/test/resilience.test.mjs && npm --prefix cloudflare run test:resilience",
    "test:workflow": "node --test test/ci-workflow.test.mjs test/documentationLinks.test.mjs test/frontendPerformance.test.mjs test/npmConnectorRelease.test.mjs test/stagingBootstrap.test.mjs test/stagingQualification.test.mjs test/drillEvidence.test.mjs test/drillConnectorRevocation.test.mjs test/drillRequestReplay.test.mjs test/drillMediaLifecycle.test.mjs test/stagingRelease.test.mjs test/productionPromotion.test.mjs",
    "test:production-promotion": "node --test test/productionPromotion.test.mjs",
    "production:validate-promotion": "node scripts/promote-production.mjs validate-local",
    "production:artifact-digests": "node scripts/promote-production.mjs source-artifact-digests",
    "verify:final-qualification": "node scripts/verify-final-qualification.mjs",
    "security:repo": "node scripts/check-repository-secrets.mjs",
    "check:docs": "node scripts/check-documentation-links.mjs",
    "qualify:staging": "node scripts/qualify-staging.mjs",
    "drill:connector-revocation": "node scripts/drill-connector-revocation.mjs",
    "drill:request-replay": "node scripts/drill-request-replay.mjs",
    "drill:media-lifecycle": "node scripts/drill-media-lifecycle.mjs",
    "test:staging-qualification": "node --test test/stagingQualification.test.mjs",
    "test:staging-drills": "node --test test/drillEvidence.test.mjs test/drillConnectorRevocation.test.mjs test/drillRequestReplay.test.mjs test/drillMediaLifecycle.test.mjs",
    "staging:validate-release": "node scripts/staging-release.mjs validate-local",
    "staging:preflight": "node scripts/staging-release.mjs preflight",
    "staging:release": "node scripts/staging-release.mjs execute",
    "staging:bootstrap": "node scripts/bootstrap-staging.mjs execute",
    "staging:validate-bootstrap": "node scripts/bootstrap-staging.mjs validate-local",
    "test:staging-release": "node --test test/stagingRelease.test.mjs",
    "pack:connector": "npm --prefix packages/connector run pack:smoke",
    "test:npm-connector-release": "node --test test/npmConnectorRelease.test.mjs",
    "manufacture:batch": "node scripts/manufacture-batch.mjs",
    "check:firmware-manifests": "node scripts/build-firmware-matrix.mjs --check --all",
    "build:firmware": "node scripts/build-firmware-matrix.mjs --release",
    "build:firmware:all": "node scripts/build-firmware-matrix.mjs --all",
    "firmware:publish": "node scripts/publish-firmware-release.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "setup:t3": "node scripts/setup-t3.mjs",
    "setup:tunnel": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-tunnel.mjs",
    "parakeet:fetch": "node scripts/fetch-parakeet-model.mjs",
    "parakeet:sidecar": "./.venv-parakeet/bin/python scripts/parakeet-sidecar.py",
    "simulate:device": "node scripts/simulate-device.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:convex": "node scripts/smoke-convex.mjs",
    "test": "npm run build:app && npm run check:frontend-performance && npm run typecheck:app && npm run typecheck:convex && npm run typecheck:cloud && npm run typecheck:cloud-control-plane && npm run test:app && npm run test:server && npm run test:connector && npm run test:cloud && npm run test:cloud-control-plane"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clerk/backend": "^3.7.0",
    "@clerk/react": "^6.12.7",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "border-beam": "^1.3.0",
    "liquid-gooey": "^0.1.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thinking-orbs": "^0.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "convex": "^1.41.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
